# Names and placeholders only; contracts are in spec/deployment.md 10.3. Never commit real values.
# local, test, development or production
APP_ENV=local
PUBLIC_APP_URL=http://localhost:3000
PORT=3000
# Server-only. Supabase transaction pooler (port 6543) as app_runtime.<project-ref>; no ?sslmode=.
DATABASE_URL=postgresql://app_runtime.your-project-ref:your-password@your-pooler-host:6543/postgres
# Server-only. Full PEM of the project's CA certificate (Database settings -> SSL Configuration).
# Also verifies MIGRATION_DATABASE_URL. Omit only for APP_ENV=local/test with a loopback database (D-30).
DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----
your-certificate
-----END CERTIFICATE-----"
# Tests only. Disposable local PostgreSQL 17 server for integration tests (D-10); tests refuse non-loopback hosts.
# Each run creates and drops its own throwaway database on it, so the role needs CREATEDB and CREATEROLE.
TEST_DATABASE_URL=postgresql://postgres:your-local-password@127.0.0.1:5432/postgres
# CI/operator only. Direct or session-mode connection used by migrations.
MIGRATION_DATABASE_URL=postgresql://your-migration-role:your-password@your-direct-or-session-host:5432/postgres
# Server-only, high-entropy, environment-specific; at least 32 characters each, and distinct (D-37).
SESSION_SECRET=your-session-secret
SESSION_TTL_SECONDS=28800
RATE_LIMIT_KEY_SECRET=your-rate-limit-key-secret
# Server-only SoC LLM settings, checked against the SoCLaaS guides (D-48). The base URL excludes /v1.
SOC_LLM_BASE_URL=https://soclaas-api.comp.nus.edu.sg
SOC_LLM_API_KEY=your-soc-llm-api-key
SOC_LLM_MODEL=default
# Production 60, development 30 (D-25).
SOC_LLM_REQUESTS_PER_MINUTE=30
# Microdollars per UTC day: production 53333333, development 26666666 (D-25).
AI_DAILY_BUDGET_MICRODOLLARS=26666666
# Microdollars per million tokens for SOC_LLM_MODEL, from GET /v1/models on 16 October 2026 (D-48).
SOC_LLM_INPUT_PRICE_MICRODOLLARS_PER_MTOK=411810
SOC_LLM_OUTPUT_PRICE_MICRODOLLARS_PER_MTOK=1456571
AI_ENABLED=false
# soc_llm or fake; fake is rejected when APP_ENV=production.
AI_PROVIDER=fake
AI_MAX_CONCURRENT_REQUESTS=1
AI_ATTEMPT_TIMEOUT_MS=30000
AI_MAX_ATTEMPTS=2
AI_EXECUTION_DEADLINE_MS=75000
AI_SUMMARY_SAMPLE_SIZE=20
AI_SUMMARY_INTERVAL_DAYS=1
AI_SUMMARY_MAX_MOVIES_PER_RUN=1
AI_MODERATION_MAX_EXECUTIONS=3
AI_MODERATION_RECOVERY_MAX_REVIEWS=1
AI_INPUT_TOKEN_LIMIT=8000
# Server-only, high-entropy, distinct per environment; at least 32 characters (D-37).
CRON_SECRET=your-cron-secret
REPORT_SUSPENSION_THRESHOLD=3
LOG_LEVEL=info
